# PNPM Configuration for Zenda ERP
# Generated: 3 de diciembre de 2025

# Recomendado para este proyecto
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true

# Mejora compatibilidad con Electron y Puppeteer
node-linker=hoisted

# Permite scripts post-install
enable-pre-post-scripts=true

# Directorio de almacenamiento compartido (opcional)
# store-dir=.pnpm-store
