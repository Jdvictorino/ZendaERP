# Base de datos PostgreSQL (Docker o local)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/zenda_db?schema=public"

# JWT Secret (genera uno seguro con: openssl rand -base64 64)
JWT_SECRET="tu_clave_secreta_jwt_aqui"
JWT_EXPIRES_IN="24h"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Servidor Backend
PORT=3001
NODE_ENV=development

# Frontend URL (para CORS)
FRONTEND_URL="http://localhost:5177"

# Contraseña del admin inicial
ADMIN_PASSWORD="contrasena_inicial_admin"

# Billing multitenant
BILLING_ENFORCEMENT_ENABLED=true
BILLING_BLOCK_MODE=auto
BILLING_ENFORCEMENT_SCHEDULER_ENABLED=true
BILLING_ENFORCEMENT_INTERVAL_MINUTES=30
BILLING_GRACE_DAYS=5
BILLING_REMINDER_DAYS=7,3,1

# Panel de administración de plataforma (SaaS)
PLATFORM_ADMIN_API_KEY="tu_api_key_de_plataforma"
PLATFORM_OWNER_EMAIL="admin@tudominio.com"
PLATFORM_OWNER_PASSWORD="tu_password_owner"

# =============================================
# PAYPAL - Suscripciones y Pagos
# =============================================
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=TU_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=TU_PAYPAL_CLIENT_SECRET
PAYPAL_PLAN_MONTHLY=TU_PLAN_ID_MENSUAL
PAYPAL_PLAN_ANNUAL=TU_PLAN_ID_ANUAL

# =============================================
# RESEND / EMAIL - Notificaciones
# =============================================
RESEND_API_KEY="re_tu_api_key"
RESEND_FROM_EMAIL="noreply@tudominio.com"
